# Backend. Defaults to local-only fictional demo. No cloud credentials needed.
SHIFT_DATABASE_URL=sqlite:///./shift.sqlite
SHIFT_DEMO_MODE=true
# Next server proxy (set in shell or apps/web/.env.local)
API_INTERNAL_URL=http://127.0.0.1:8000
# Future production: verified Supabase auth and RLS must land before demo mode is disabled.
# Optional hosted identity (use a real Supabase project; do NOT enable demo mode):
# SHIFT_DEMO_MODE=false
# SHIFT_DATABASE_URL=postgresql+psycopg://SERVER_ONLY_DATABASE_CREDENTIALS
# SHIFT_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Browser public settings go in apps/web/.env.local:
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Never put a service-role key or a database password in NEXT_PUBLIC_* variables.

# ---- Shift V1 marketplace (all server-side; never NEXT_PUBLIC_*) ----
# Session cookie signing key. Required when SHIFT_DEMO_MODE=false.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SHIFT_SESSION_SECRET=
# Set true when served over HTTPS.
SHIFT_COOKIE_SECURE=false
# Public origin of the web app; Google redirects to <this>/api/v1/auth/google/callback.
SHIFT_PUBLIC_BASE_URL=http://127.0.0.1:3000
# Google Cloud OAuth client (Web application). Leave empty to use the local demo sign-in.
# Authorized redirect URI: http://127.0.0.1:3000/api/v1/auth/google/callback
SHIFT_GOOGLE_CLIENT_ID=
SHIFT_GOOGLE_CLIENT_SECRET=
# Fernet key that encrypts stored Google Calendar refresh tokens. Calendar sync stays off without it.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SHIFT_TOKEN_ENCRYPTION_KEY=
# Private folder for credential documents (served only through short-lived signed links).
SHIFT_UPLOAD_DIR=./.data/uploads
