# Optional local-demo configuration. dev_api.py explicitly enables local mode.
# Never use these demo settings for hosted deployment.
SHIFT_ENVIRONMENT=local
SHIFT_DEMO_MODE=true
SHIFT_DATABASE_URL=sqlite:///./shift.sqlite
API_INTERNAL_URL=http://127.0.0.1:8000

# Hosted backend (set in the API environment; do not commit real values):
# SHIFT_ENVIRONMENT=hosted
# SHIFT_DEMO_MODE=false
# SHIFT_DATABASE_URL=postgresql+psycopg://RUNTIME_LOGIN:PASSWORD@HOST:5432/DATABASE
# SHIFT_SUPABASE_URL=https://PROJECT.supabase.co
# SHIFT_JWT_AUDIENCE=authenticated

# Hosted web (set in apps/web/.env.local locally, or hosting environment):
# NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_KEY
# Public key only. Never place a service-role key, JWT secret or DB password here.
